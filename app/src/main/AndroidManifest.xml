<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AOSP 直通弹窗（ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS）的声明前提（feature/onboarding 引导主路径）。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+ 包可见性：feature/onboarding 的 ROM_ENTRIES 厂商管家包名逐一对齐，
         resolveActivity 探测不到即视为未装管家，静默落到应用详情页兜底。 -->
    <queries>
        <!-- 小米 MIUI / HyperOS（xiaomi / redmi） -->
        <package android:name="com.miui.securitycenter" />
        <!-- 华为 EMUI / HarmonyOS（huawei） -->
        <package android:name="com.huawei.systemmanager" />
        <!-- 荣耀 MagicOS（honor） -->
        <package android:name="com.hihonor.systemmanager" />
        <!-- OPPO ColorOS（oppo / oneplus / realme，两代管家包名） -->
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <!-- vivo OriginOS / iQOO（vivo / iqoo） -->
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
    </queries>

    <application
        android:name=".AwakeApplication"
        android:label="Awake_DW"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AwakeDW">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
