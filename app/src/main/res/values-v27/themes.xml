<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- API 27+：浅色导航栏深色指示（windowLightNavigationBar 自 27 起可用）。 -->
    <style name="Theme.AwakeDW.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/awake_window_background</item>
        <item name="android:statusBarColor">@color/awake_window_background</item>
        <item name="android:navigationBarColor">@color/awake_window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
